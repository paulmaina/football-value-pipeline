# Local collector process lease
football_output_v2/closing_odds/collector.lock


# BBS collector lease and atomic-write temporary files (data stays tracked)
.football_cache/bbs/state.lock
.football_cache/api_football/.collect.lock/
# Interrupted archive staging is never a published forecast snapshot.
football_output_v2/performance/snapshots/.capture-*/

# In-progress generation leases and staging are never published.
football_output_v2/raw/.prediction-run.lock/
football_output_v2/raw/.prediction-run.lock.stale-*/
football_output_v2/.prediction-stage-*/
football_output_v2/.prediction-backup-*/
**/.run-write-*

