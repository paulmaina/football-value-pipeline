# Current forecast CSVs have a consistent repository representation.
football_output_v2/raw/*.csv text eol=lf
# UCL refresh metadata binds these files by their exact UTF-8/LF hash.
.football_cache/fdorg_history_UCL_*.json text eol=lf
# Never normalize immutable snapshot bytes after their SHA-256 is recorded.
football_output_v2/performance/snapshots/** -text

# Complete local prediction generations are immutable byte-bound bundles.
football_output_v2/raw/prediction_runs/** -text
# Preserve complementary-source observation/recovery bytes across Windows/Linux.
.football_cache/api_football/** -text
# T1 result provenance binds the downloaded source bytes by SHA-256.
football_output_v2/performance/result_sources/** -text
# Understat history: manifest.json binds each season file by its exact bytes (SHA-256).
.football_cache/understat/** -text
# European backfill and domestic-form backfill: manifest.json binds each raw file by its exact bytes (SHA-256).
.football_cache/europa/backfill/** -text
.football_cache/domestic_backfill/** -text
# Golden copies of main's master outputs (tests/test_master_release.py): LF on every platform.
tests/fixtures/master_release_pre_release/** text eol=lf
